generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProgressionScheme {
  LINEAR
  GREYSKULL
  DOUBLE_PROGRESSION
  TIME_BASED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  exercises   Exercise[]
  routines    Routine[]
  sessions    WorkoutSession[]
  bodyWeights BodyWeightLog[]

  @@map("users")
}

model Exercise {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  muscleGroup String  @map("muscle_group")
  equipment   String?
  videoUrl    String? @map("video_url")
  createdById String? @map("created_by") @db.Uuid

  createdBy        User?             @relation(fields: [createdById], references: [id])
  routineExercises RoutineExercise[]

  @@map("exercises")
}

model Routine {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user            User              @relation(fields: [userId], references: [id])
  exercises       RoutineExercise[]
  workoutSessions WorkoutSession[]

  @@map("routines")
}

model RoutineExercise {
  id                String             @id @default(uuid()) @db.Uuid
  routineId         String             @map("routine_id") @db.Uuid
  exerciseId        String             @map("exercise_id") @db.Uuid
  order             Int
  targetSets        Int                @map("target_sets")
  targetReps        Int                @map("target_reps")
  targetWeight      Decimal?           @map("target_weight") @db.Decimal(8, 2)
  supersetGroupId   String?            @map("superset_group_id") @db.Uuid
  progressionScheme ProgressionScheme? @map("progression_scheme")

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  sessionSets SessionSet[]

  @@unique([routineId, order])
  @@index([routineId])
  @@index([exerciseId])
  @@map("routine_exercises")
}

model WorkoutSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  routineId String   @map("routine_id") @db.Uuid
  date      DateTime @default(now())
  notes     String?

  user    User    @relation(fields: [userId], references: [id])
  routine Routine @relation(fields: [routineId], references: [id])

  sets SessionSet[]

  @@index([userId])
  @@index([routineId])
  @@index([date])
  @@map("workout_sessions")
}

model SessionSet {
  id                String  @id @default(uuid()) @db.Uuid
  sessionId         String  @map("session_id") @db.Uuid
  routineExerciseId String  @map("routine_exercise_id") @db.Uuid
  setNumber         Int     @map("set_number")
  reps              Int
  weight            Decimal @db.Decimal(8, 2)
  isDropset         Boolean @default(false) @map("is_dropset")
  isRestpause       Boolean @default(false) @map("is_restpause")

  session         WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  routineExercise RoutineExercise @relation(fields: [routineExerciseId], references: [id])

  @@unique([sessionId, routineExerciseId, setNumber])
  @@index([sessionId])
  @@index([routineExerciseId])
  @@map("session_sets")
}

model BodyWeightLog {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  weight Decimal  @db.Decimal(6, 2)
  date   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("body_weight_logs")
}
